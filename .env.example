# =============================================================================
# JARVIS configuration
#
# You don't need this file to get started: the setup screen that opens on first
# run asks for your name, your AI provider and your API key, and stores the key
# sealed with Windows' own encryption. Copy this to .env only to change the
# advanced settings below.
# =============================================================================

# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------
# Which models JARVIS may use.
#   auto    — the provider you chose in setup, with local Ollama as a fallback
#             if it's installed (default).
#   ollama  — local only. Nothing is sent to any cloud API, ever: no cloud
#             provider is constructed, so no code path can reach one.
JARVIS_AI_PROVIDER=auto

# API keys can also live here instead of in setup (setup's sealed copy wins).
# On macOS/Linux, where there is no built-in sealing, this is the only place.
#   ANTHROPIC_API_KEY=   OPENAI_API_KEY=   GEMINI_API_KEY=   GROQ_API_KEY=
#   MISTRAL_API_KEY=     XAI_API_KEY=      DEEPSEEK_API_KEY= OPENROUTER_API_KEY=
#   TOGETHER_API_KEY=    CUSTOM_AI_API_KEY=

# Install from https://ollama.com, then pull at least one model:
#   ollama pull llama3.2        conversation, tools  (~2 GB)
#   ollama pull gemma3          vision               (~3 GB)
#   ollama pull qwen2.5-coder   better self-editing  (optional)
# JARVIS_OLLAMA_HOST wins over OLLAMA_HOST. OLLAMA_HOST is Ollama's own
# server-bind variable and is often already set to 0.0.0.0 system-wide, which
# is a valid address to listen on and a useless one to connect to. Set this if
# your Ollama is not on the default loopback address.
JARVIS_OLLAMA_HOST=
OLLAMA_HOST=http://127.0.0.1:11434
# Leave blank to auto-select per purpose from what you have pulled.
JARVIS_OLLAMA_MODEL=

# Per-purpose overrides. Blank = chosen automatically from the capabilities
# Ollama reports (tool support, vision, context size), preferring families
# measured to call tools reliably. Set one only to overrule that choice.
JARVIS_OLLAMA_CONVERSATION=
JARVIS_OLLAMA_FAST=
JARVIS_OLLAMA_REASONING=
JARVIS_OLLAMA_CODING=
JARVIS_OLLAMA_VISION=

JARVIS_MAX_TOKENS=4096

# Claude models used when ANTHROPIC_API_KEY is set here (rather than chosen in
# setup). Ignored in local-only mode.
JARVIS_MODEL_PRIMARY=claude-opus-5-5
JARVIS_MODEL_FAST=claude-haiku-5-5
JARVIS_MODEL_REASONING=claude-opus-5-5
JARVIS_MODEL_CODING=claude-opus-5-5
JARVIS_MODEL_VISION=claude-opus-5-5

# Self-editing: JARVIS rewriting its own source uses a SEPARATE model from
# the one holding the conversation. Leave blank to route to the coding model.
# Requires the 'Edit its own code' permission, which is off by default.
JARVIS_SELFEDIT_PROVIDER=
JARVIS_SELFEDIT_MODEL=

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# local    = connections from this machine are trusted (correct for a personal
#            desktop; remote requests are still rejected)
# password = everyone must log in with JARVIS_PASSWORD
JARVIS_AUTH_MODE=local
JARVIS_PASSWORD=

# Sessions are signed with a key generated on first run and stored in data/.
# Set this only if you want to pin it (e.g. across machines).
JARVIS_SECRET_KEY=
JARVIS_SESSION_HOURS=336

# Folders JARVIS's file tools may touch. Comma-separated. Anything outside is
# refused at the boundary. Defaults to your home folder.
JARVIS_FILE_ROOTS=

# -----------------------------------------------------------------------------
# Personal
# -----------------------------------------------------------------------------
# Your name and the assistant's are set in the setup screen; these are only
# fallbacks for when setup hasn't been completed.
JARVIS_OWNER_NAME=
JARVIS_ASSISTANT_NAME=JARVIS
JARVIS_WAKE_WORD=jarvis
JARVIS_TTS_VOICE=en-GB-RyanNeural
# City for the weather tool, e.g. "Manchester, UK". Works with no account.
JARVIS_WEATHER_LOCATION=

# -----------------------------------------------------------------------------
# Engine tuning
# -----------------------------------------------------------------------------
JARVIS_WORKERS=3
JARVIS_TASK_MAX_RETRIES=3
JARVIS_SCHEDULER_TICK=20
JARVIS_METRICS_INTERVAL=3
JARVIS_METRICS_RETENTION_HOURS=48
JARVIS_LOG_LEVEL=INFO

# Speech-to-text model size: tiny, base, small, medium, large
WHISPER_MODEL=base

# -----------------------------------------------------------------------------
# Integrations — all optional. Missing ones are shown in the UI with exactly
# which variables they need and where to get them.
# -----------------------------------------------------------------------------

# GitHub — repositories, issues, PRs, CI. github.com/settings/tokens
GITHUB_TOKEN=

# Home Assistant — lights, plugs, thermostats, scenes, locks.
# Token from your HA profile page.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Google Calendar — needs an OAuth app you create (not implemented yet; see
# docs/INTEGRATIONS.md). Email doesn't use these: connect Gmail, Outlook,
# iCloud or Yahoo in the Email panel with an app password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spotify — playback control. developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Wake-word engine (optional, for always-on hotword detection)
PICOVOICE_ACCESS_KEY=
